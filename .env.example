# DashScope compatible Qwen API key. Keep this file local and never commit the real key.
DASHSCOPE_API_KEY=
# Optional override, defaults to qwen3.6-plus in this workspace
# MaaS workspace model ID (the workspace exposes qwen3.6-plus without a hyphen).
QWEN_MODEL=qwen3.6-plus
# Set to 0 only if you need to disable the temporary coordinate frame sent to Qwen.
QWEN_COORDINATE_FRAME=1
# MaaS OpenAI-compatible endpoint. Replace with your workspace endpoint.
QWEN_ENDPOINT=https://ws-yqr3lqq5xyjbxf30.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
# Vision requests can queue on a busy MaaS workspace; keep enough time for one response.
QWEN_REQUEST_TIMEOUT=180
